USE_LOCAL_STORAGE=true
LOCAL_LAKEHOUSE_ROOT=./data/lakehouse
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_CONTAINER_NAME=retailflow

# Airflow failure alerts (SMTP). A Gmail App Password works for testing.
ALERT_EMAIL=you@example.com
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_USER=you@example.com
AIRFLOW__SMTP__SMTP_PASSWORD=your_app_password
AIRFLOW__SMTP__SMTP_MAIL_FROM=you@example.com
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False

# Metabase admin, read by dashboard/setup_metabase.py. Metabase rejects common passwords.
MB_ADMIN_EMAIL=you@example.com
MB_ADMIN_PASSWORD=RetailFlow-demo-2026
